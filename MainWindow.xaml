<Window x:Class="MirrorHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MirrorHub" Icon="/app.ico" Height="740" Width="1020" MinWidth="840" MinHeight="600">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,16,8"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,6"/>
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">
            <!-- ===================== Android ===================== -->
            <TabItem Header="Android">
                <Grid Margin="8" AllowDrop="True" Drop="Android_Drop" DragOver="Android_DragOver">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Devices" Style="{StaticResource Header}"/>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="Connection" Style="{StaticResource SubHeader}"/>
                            <WrapPanel>
                                <Button Content="Connect IP…" Click="ConnectIp_Click"/>
                                <Button Content="Pair with QR…" Click="PairQr_Click"/>
                                <Button Content="Pair with code…" Click="PairCode_Click"/>
                                <Button Content="USB → Wi-Fi" Click="UsbToWifi_Click"/>
                                <Button Content="Disconnect" Click="Disconnect_Click"/>
                            </WrapPanel>
                            <TextBlock Text="Tools" Style="{StaticResource SubHeader}"/>
                            <WrapPanel>
                                <Button Content="Install APK…" Click="InstallApk_Click"/>
                                <Button Content="Send files…" Click="SendFiles_Click"/>
                                <Button Content="Launch app…" Click="StartApp_Click"/>
                                <Button Content="Camera…" Click="OpenCamera_Click"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Drop files or APKs here: APKs are installed, other files are copied to Download on the phone."/>
                        </StackPanel>
                        <ListBox x:Name="DeviceList" DisplayMemberPath="Label" SelectionChanged="DeviceList_SelectionChanged"/>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Mirroring" Style="{StaticResource Header}"/>
                            <WrapPanel>
                                <Button Content="▶ Start mirroring" FontWeight="SemiBold" Click="Start_Click"/>
                                <Button Content="♪ Audio only" Click="AudioOnly_Click"
                                        ToolTip="Phone sound on the PC, no video and no window: very light, can stay on in the background (e.g. while gaming). Android 11+."/>
                                <Button Content="■ Stop" Click="Stop_Click"/>
                                <Button Content="Screenshot" Click="Screenshot_Click"/>
                                <Button Content="Output folder" Click="OpenFolder_Click"/>
                            </WrapPanel>

                            <StackPanel x:Name="MirrorOptionsPanel">
                                <TextBlock x:Name="ProfileNote" Foreground="#1a5fb4" Margin="0,4,0,0" Visibility="Collapsed"/>

                                <TextBlock Text="Quality" Style="{StaticResource SubHeader}"/>
                                <StackPanel x:Name="AndroidQuality"/>

                                <TextBlock Text="Options" Style="{StaticResource SubHeader}"/>
                                <WrapPanel>
                                    <CheckBox Content="Phone sound on the PC" IsChecked="{Binding Audio}"/>
                                    <CheckBox Content="Also keep the sound on the phone" IsChecked="{Binding AudioOnPhoneToo}"
                                              ToolTip="Sound plays on both the PC and the phone (also for &quot;♪ Audio only&quot;). Android 13 or newer. Apps that block audio capture are then heard only on the phone."/>
                                    <CheckBox Content="Control the phone with mouse and keyboard" IsChecked="{Binding Control}"/>
                                    <CheckBox Content="Record (.mkv)" IsChecked="{Binding Record}"/>
                                    <CheckBox Content="Start mirroring when the phone connects" IsChecked="{Binding AutoMirror}"/>
                                </WrapPanel>

                                <Expander x:Name="AndroidAdvanced" Header="Advanced settings" Margin="0,8,0,0"
                                          Expanded="Advanced_Toggled" Collapsed="Advanced_Toggled">
                                <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Settings for" Style="{StaticResource SubHeader}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Delete profile" Click="DeleteProfile_Click" Margin="6,0,0,6"/>
                                    <Button DockPanel.Dock="Right" Content="New profile for the selected device" Click="CreateProfile_Click" Margin="6,0,0,6"/>
                                    <ComboBox x:Name="ProfileBox" DisplayMemberPath="Label" SelectionChanged="ProfileBox_SelectionChanged"/>
                                </DockPanel>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Video codec" Style="{StaticResource Lbl}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="VideoCodecBox" SelectedItem="{Binding VideoCodec}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Bitrate (Mbps)" Style="{StaticResource Lbl}"/>
                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding BitRateMbps}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Max FPS" Style="{StaticResource Lbl}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxFps}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Max resolution (0 = native)" Style="{StaticResource Lbl}"/>
                                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding MaxSize}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Video buffer (ms)" Style="{StaticResource Lbl}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding VideoBufferMs}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="HW decoding" Style="{StaticResource Lbl}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="4" x:Name="HwDecBox" SelectedItem="{Binding HwDec}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Audio codec" Style="{StaticResource Lbl}"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="AudioCodecBox" SelectedItem="{Binding AudioCodec}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="Audio buffer (ms)" Style="{StaticResource Lbl}"/>
                                    <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding AudioBufferMs}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Fit" Style="{StaticResource Lbl}"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="RenderFitBox" SelectedItem="{Binding RenderFit}"/>
                                </Grid>

                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox Content="Keep phone awake" IsChecked="{Binding StayAwake}"/>
                                    <CheckBox Content="Turn phone screen off" IsChecked="{Binding TurnScreenOff}"/>
                                    <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}"/>
                                    <CheckBox Content="Fullscreen" IsChecked="{Binding Fullscreen}"/>
                                    <CheckBox Content="Borderless" IsChecked="{Binding Borderless}"/>
                                    <CheckBox Content="Auto-reconnect" IsChecked="{Binding AutoReconnect}"/>
                                </WrapPanel>

                                <TextBlock Style="{StaticResource Hint}"
                                           Text="A device with a profile uses its own settings; all others use the defaults. Changing a value here turns the quality into &quot;Custom&quot;."/>
                                </StackPanel>
                                </Expander>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Changes apply from the next mirroring start (including automatic reconnections). Shortcuts in the mirror window: Alt+F fullscreen · Alt+H home · Alt+B back · Alt+S recent apps · Alt+R rotate · Alt+O phone screen off · Alt+Shift+O on."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===================== iPhone / iPad ===================== -->
            <TabItem Header="iPhone / iPad">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AirPanel" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="AirPlay receiver" Style="{StaticResource Header}"/>
                        <TextBlock x:Name="AirStatus" Text="Stopped" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="▶ Start receiver" FontWeight="SemiBold" Click="AirStart_Click"/>
                            <Button Content="♪ Audio only" Click="AirAudio_Click"
                                    ToolTip="Sound from the iPhone/iPad on the PC, no video window. Lighter than screen mirroring."/>
                            <Button Content="■ Stop" Click="AirStop_Click"/>
                            <Button Content="Output folder" Click="OpenFolder_Click"/>
                        </WrapPanel>

                        <Border x:Name="AirProblem" Visibility="Collapsed" Background="#FFF4E5" BorderBrush="#E8A33D"
                                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,6">
                            <StackPanel>
                                <TextBlock x:Name="AirProblemText" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="AirProblemActions" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                   Text="On the iPhone/iPad: Control Center → Screen Mirroring → pick the name below. PC and iPhone must be on the same Wi-Fi. &quot;♪ Audio only&quot;: sound without a video window; music and video apps can also send sound with their own AirPlay icon (better quality)."/>

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Name shown on the iPhone" Style="{StaticResource Lbl}"/>
                            <TextBox Text="{Binding AirPlayName}" Width="240" HorizontalAlignment="Left"/>
                        </DockPanel>

                        <TextBlock Text="Quality" Style="{StaticResource SubHeader}"/>
                        <StackPanel x:Name="AirQuality"/>

                        <TextBlock Text="Options" Style="{StaticResource SubHeader}"/>
                        <WrapPanel>
                            <CheckBox Content="Fullscreen" IsChecked="{Binding AirPlayFullscreen}"/>
                            <CheckBox Content="Record (.mp4)" IsChecked="{Binding AirPlayRecord}"/>
                            <CheckBox Content="Lowest latency (games)" IsChecked="{Binding AirPlayLowLatency}"
                                      ToolTip="Shows each frame as soon as it arrives. Less delay, but sound and picture are no longer kept in sync."/>
                        </WrapPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="iPhones/iPads at the same time" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="AirCountBox" SelectedItem="{Binding AirPlayReceivers}" Width="70" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Text="Each one gets its own name (MirrorHub, MirrorHub 2…) and its own window."/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Sound delay (ms)" Style="{StaticResource Lbl}"/>
                            <TextBox Text="{Binding AirPlayAudioDelayMs}" Width="70" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Text="If you hear the sound before you see the picture, raise it (try 100, then 200). Max 999. Not used with &quot;Lowest latency&quot;."/>
                        </DockPanel>

                        <Expander x:Name="AirAdvanced" Header="Advanced settings" Margin="0,8,0,0"
                                  Expanded="Advanced_Toggled" Collapsed="Advanced_Toggled">
                        <StackPanel Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolution" Style="{StaticResource Lbl}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AirResBox" IsEditable="True" Text="{Binding AirPlayResolution}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Max FPS" Style="{StaticResource Lbl}"/>
                            <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding AirPlayFps}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Renderer" Style="{StaticResource Lbl}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AirSinkBox" SelectedItem="{Binding AirPlayVideoSink}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="PIN (4 digits, empty = none)" Style="{StaticResource Lbl}"/>
                            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding AirPlayPin}" MaxLength="4"/>
                        </Grid>

                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox Content="H.265" IsChecked="{Binding AirPlayH265}"/>
                            <CheckBox Content="New device replaces the current one" IsChecked="{Binding AirPlayNoHold}"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Set up firewall again" Click="Firewall_Click"/>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Renderer &quot;auto&quot; works everywhere; d3d12videosink can be smoother on recent graphics cards. The network must be Private in Windows (no guest networks with client isolation). Changing a value here turns the quality into &quot;Custom&quot;."/>
                        </StackPanel>
                        </Expander>

                        <TextBlock Style="{StaticResource Hint}" Text="Changes apply from the next receiver start."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Settings ===================== -->
            <TabItem x:Name="SettingsTab" Header="Settings">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Startup" Style="{StaticResource Header}"/>
                        <CheckBox Content="Start MirrorHub when Windows starts"
                                  IsChecked="{Binding StartWithWindows}" Click="StartupOption_Click"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Start minimized" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="MinimizedModeBox" Width="280" SelectionChanged="MinimizedMode_Changed">
                                <ComboBoxItem Content="Never"/>
                                <ComboBoxItem Content="Only when started by Windows"/>
                                <ComboBoxItem Content="Always"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Content="Start the AirPlay receiver when MirrorHub opens"
                                  IsChecked="{Binding AirPlayAutoStart}" Click="SaveSettings_Click"/>

                        <TextBlock Text="Notification area" Style="{StaticResource Header}" Margin="0,16,0,8"/>
                        <CheckBox Content="When minimized, hide the window in the notification area (next to the clock)"
                                  IsChecked="{Binding MinimizeToTray}" Click="SaveSettings_Click"/>
                        <CheckBox Content="When the window is closed, keep MirrorHub running in the notification area"
                                  IsChecked="{Binding CloseToTray}" Click="SaveSettings_Click"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                                   Text="Right-click the icon for the management menu; double-click to open the window. To quit: icon menu → Exit."/>

                        <TextBlock Text="Notifications" Style="{StaticResource Header}" Margin="0,16,0,8"/>
                        <CheckBox Content="Android device connected" IsChecked="{Binding Notify.DeviceConnected}" Click="SaveSettings_Click"/>
                        <CheckBox Content="Android device disconnected" IsChecked="{Binding Notify.DeviceDisconnected}" Click="SaveSettings_Click"/>
                        <CheckBox Content="Mirroring interrupted or reconnecting" IsChecked="{Binding Notify.MirrorEvents}" Click="SaveSettings_Click"/>
                        <CheckBox Content="iPhone / iPad connected or connection lost" IsChecked="{Binding Notify.AirPlayClient}" Click="SaveSettings_Click"/>
                        <CheckBox Content="Screenshots and recordings saved" IsChecked="{Binding Notify.FileSaved}" Click="SaveSettings_Click"/>

                        <TextBlock Text="Global keyboard shortcuts" Style="{StaticResource Header}" Margin="0,16,0,8"/>
                        <Grid x:Name="HotkeyGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <WrapPanel>
                            <Button Content="Restore defaults" Click="ResetHotkeys_Click"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                                   Text="Click a box and press the combination (at least one of Ctrl, Alt, Shift, Win). Esc cancels. They work everywhere, even while MirrorHub is hidden. Mirroring and screenshot act on the selected device (or the first connected one)."/>

                        <TextBlock Text="Files" Style="{StaticResource Header}" Margin="0,16,0,8"/>
                        <TextBlock Text="Folder for recordings and screenshots" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open" Click="OpenFolder_Click" Margin="6,0,0,6"/>
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseOutput_Click" Margin="6,0,0,6"/>
                            <TextBox Text="{Binding OutputDir}"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Options apply immediately. Settings are stored in %AppData%\MirrorHub\settings.json."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Log -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Content="Copy log" Click="CopyLog_Click" Padding="8,1" Margin="0,0,0,4"/>
                <TextBlock Text="Log (if something does not work, click &quot;Copy log&quot; and send it)" Foreground="Gray" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="LogBox"
                     IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</Window>
