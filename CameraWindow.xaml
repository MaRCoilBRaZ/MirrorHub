<Window x:Class="MirrorHub.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MirrorHub – Phone camera" Icon="/app.ico"
        SizeToContent="Height" Width="560" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,16,8"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,6"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <TextBlock x:Name="Status" Text="Stopped" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <WrapPanel>
            <Button x:Name="StartButton" Content="▶ Start camera" FontWeight="SemiBold" Click="Start_Click"/>
            <Button Content="■ Stop" Click="Stop_Click"/>
        </WrapPanel>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Device" Style="{StaticResource Lbl}"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DeviceBox" DisplayMemberPath="Display" SelectionChanged="Device_Changed"/>
            <Button Grid.Row="0" Grid.Column="2" Content="Refresh" Margin="6,0,0,6" Click="Refresh_Click"/>
            <TextBlock Grid.Row="1" Text="Camera" Style="{StaticResource Lbl}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CameraBox"
                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Camera_Changed"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Max resolution (px)" Style="{StaticResource Lbl}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaxSize}"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="FPS" Style="{StaticResource Lbl}"/>
            <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Fps}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Zoom (e.g. 1.5)" Style="{StaticResource Lbl}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Zoom}"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Rotation (°)" Style="{StaticResource Lbl}"/>
            <ComboBox Grid.Row="1" Grid.Column="4" x:Name="OrientationBox" SelectedItem="{Binding Orientation}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Video codec" Style="{StaticResource Lbl}"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CodecBox" SelectedItem="{Binding VideoCodec}"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Text="Bitrate (Mbps)" Style="{StaticResource Lbl}"/>
            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding BitRateMbps}"/>
        </Grid>

        <WrapPanel Margin="0,6,0,0">
            <CheckBox Content="Mirror (selfie view)" IsChecked="{Binding Flip}"/>
            <CheckBox Content="Phone microphone" IsChecked="{Binding Microphone}"/>
            <CheckBox Content="Torch on" IsChecked="{Binding Torch}"/>
            <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}"/>
            <CheckBox Content="Borderless" IsChecked="{Binding Borderless}"/>
            <CheckBox Content="Record (.mkv)" IsChecked="{Binding Record}"/>
        </WrapPanel>

        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"
                   Text="Requires Android 12 or later. The video opens in a &quot;MirrorHub Camera&quot; window. To use it as a webcam (Zoom, Teams, Discord…): in OBS add a &quot;Window Capture&quot; source on that window, then &quot;Start Virtual Camera&quot;. Changes apply from the next start."/>
    </StackPanel>
</Window>
